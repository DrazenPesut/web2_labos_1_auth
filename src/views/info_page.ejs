<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Digitalna propusnica</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 24px; background: #eef1f5; color: #333; }
    .pass { max-width: 420px; margin: 40px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .pass-header { padding: 20px 24px; color: #fff; }
    .pass-header.active { background: #28a745; }
    .pass-header.cancelled { background: #dc3545; }
    .pass-header.notfound { background: #6c757d; }
    .pass-header h1 { margin: 0; font-size: 1.2em; }
    .pass-header .status { margin-top: 6px; font-size: 1.6em; font-weight: bold; letter-spacing: 1px; }
    .pass-body { padding: 24px; }
    .row { margin-bottom: 18px; }
    .label { font-size: 0.75em; text-transform: uppercase; color: #888; letter-spacing: 0.5px; }
    .value { font-size: 1.15em; margin-top: 2px; }
    .id { font-family: monospace; font-size: 0.8em; color: #999; word-break: break-all; border-top: 1px dashed #ccc; padding-top: 14px; }
  </style>
</head>
<body>
  <div class="pass">
    <% if (pass) { %>
      <div class="pass-header <%= pass.status.toLowerCase() %>">
        <h1>Digitalna propusnica</h1>
        <div class="status"><%= pass.status %></div>
      </div>
      <div class="pass-body">
        <div class="row">
          <div class="label">Ime i prezime</div>
          <div class="value"><%= pass.name %></div>
        </div>
        <div class="row">
          <div class="label">Oznaka dokumenta</div>
          <div class="value"><%= pass.document %></div>
        </div>
        <div class="row">
          <div class="label">Vrijeme izdavanja</div>
          <div class="value"><%= new Date(pass.issued_at).toLocaleString('hr-HR', { timeZone: 'Europe/Zagreb' }) %></div>
        </div>
        <div class="id"><%= pass.id %></div>
      </div>
    <% } %>
  </div>
</body>
</html>